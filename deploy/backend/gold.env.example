# Copy to ignored server/.env.gold.local for local development only.
# Obtain the actual read-only container SAS through the authorized private channel.
PROMETHEUS_GOLD_AUTH=sas
PROMETHEUS_GOLD_SAS_TOKEN=
PROMETHEUS_GOLD_REFRESH_SECONDS=30
# Instead of the token variable, an external private JSON can be used:
# PROMETHEUS_GOLD_ACCESS_FILE=C:/Users/pc/.prometheus/secrets/gold-access.json
