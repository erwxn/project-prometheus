{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{shared/**,test-data/harmonized/**}",
      "excludeFiles": "{server/data/**,test-data/vis-data/**,server/*.test.js}"
    }
  },
  "routes": [
    {
      "src": "/health",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/about/?",
      "dest": "/about/index.html"
    },
    {
      "src": "/analytics/?",
      "dest": "/analytics/index.html"
    },
    {
      "src": "/monitor/?",
      "dest": "/monitor/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
